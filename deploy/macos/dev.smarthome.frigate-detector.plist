<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.smarthome.frigate-detector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec /Users/ti/Library/SmartHome/apple-silicon-detector/venv/bin/python3 /Users/ti/Library/SmartHome/apple-silicon-detector/detector/zmq_onnx_client.py --model AUTO --endpoint tcp://127.0.0.1:5555</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/ti/Library/Logs/frigate-detector.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ti/Library/Logs/frigate-detector.err.log</string>
</dict>
</plist>
